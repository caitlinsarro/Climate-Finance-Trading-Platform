# Copy to .env.local or export these variables in your shell.
# Never commit actual keys. The ingestion script reports only configured/missing.

# SEC public data does not require a key, but automated requests need an
# identifiable User-Agent. A public project URL is acceptable contact context.
SEC_USER_AGENT=Climate-Finance-Trading-Platform/1.0 https://github.com/zilunhe713-ops/Climate-Finance-Trading-Platform

# Free registration:
# https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Free FRED account and application key:
# https://fred.stlouisfed.org/docs/api/fred/v2/api_key.html
FRED_API_KEY=

# Free registration with a durable email address:
# https://apps.bea.gov/api/signup/
BEA_API_KEY=
